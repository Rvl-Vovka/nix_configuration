{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
		"source": "/home/vlryz/.config/fastfetch/logo.png",
		"type": "kitty",
		"width": 42,
		"height": 21
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "bios",
        "kernel",
        "uptime",
        "shell",
        "terminal",
        {
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "type": "gpu",
            "driverSpecific": true,
            "temp": true
        },
        "memory",
        "physicalmemory",
        {
            "type": "swap",
            "separate": true
        },
        "disk",
        {
            "type": "battery",
            "temp": true
        },
        "poweradapter",
        "player",
        "media",
        {
            "type": "localip",
            "showIpv6": false,
            "showMac": false,
            "showSpeed": false,
            "showMtu": false,
            "showLoop": false,
            "showFlags": false,
            "showAllIps": false
        },
        "wifi",
        "bluetooth",
        "sound",
        {
            "type": "physicaldisk",
            "temp": true
        },
        "version",
    ]
}
